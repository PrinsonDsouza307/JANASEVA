        isValidTime(data.assignedAt) &&
        isValidOptionalString(data, 'assignedBy', 0, 100) &&
        isValidOptionalEmail(data, 'assignedByEmail') &&
        isValidOptionalString(data, 'status', 0, 50) &&
        isValidOptionalString(data, 'notes', 0, 2000);
    }

    // Domain Validator: AI Knowledge Centre Async Processing Jobs (knowledge_processing_jobs/{jobId})
    function isValidKnowledgeProcessingJob(data) {
      return data.keys().hasAll([
        'jobId', 'filename', 'tempStoragePath', 'status', 'startedAt', 'sourceReliability'
      ]) &&
      data.keys().hasOnly([
        'jobId', 'filename', 'tempStoragePath', 'status', 'startedAt', 'sourceReliability',
        'mimeType', 'sizeBytes', 'fileHash', 'contributorId', 'contributorName',
        'contributorRole', 'categoryHint', 'replaceDocId', 'updatedAt', 'sourceChannel'
      ]) &&
      data.jobId is string && data.jobId.size() >= 1 && data.jobId.size() <= 100 &&
      data.filename is string && data.filename.size() >= 1 && data.filename.size() <= 200 &&
      data.tempStoragePath is string &&
      data.tempStoragePath.size() >= 39 &&
      data.tempStoragePath.size() <= 400 &&
      data.tempStoragePath.matches("^AI_KNOWLEDGE_CENTRE/temporary_uploads/[^/].*") &&
      !data.tempStoragePath.matches(".*\\.\\..*") &&
      data.status is string && data.status == 'QUEUED' &&
      isValidTime(data.startedAt) &&
      data.sourceReliability is string && data.sourceReliability == 'community' &&
      isValidOptionalString(data, 'mimeType', 0, 120) &&
      (!('sizeBytes' in data) || data.sizeBytes == null || ((data.sizeBytes is int || data.sizeBytes is number) && data.sizeBytes >= 0 && data.sizeBytes <= 52428800)) &&
      isValidOptionalString(data, 'fileHash', 0, 128) &&
      isValidOptionalString(data, 'contributorId', 0, 128) &&
      isValidOptionalString(data, 'contributorName', 0, 80) &&
      (!('contributorRole' in data) || data.contributorRole == null || data.contributorRole == '' || (data.contributorRole is string && data.contributorRole in ['public', 'citizen', 'admin'])) &&
      isValidOptionalString(data, 'categoryHint', 0, 80) &&
      isValidOptionalString(data, 'replaceDocId', 0, 100) &&
      isValidOptionalTime(data, 'updatedAt') &&
      isValidOptionalString(data, 'sourceChannel', 0, 50);
    }

    // =============================================================
    // Collection Rules
    // =============================================================

    // -------------------------------------------------------------
    // 1. Users Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      // PII Protection: Users can read their own profile. Admins can read all profiles.
      // Blanket read (allow read: if isAuthenticated();) is strictly denied.
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // User Registration:
      // - Users can register their own profile with default role 'citizen'.
      // - Users cannot self-elevate to 'admin' or 'receiver'.
      // - Admins can create user profiles with any valid role.
      allow create: if isAuthenticated() &&
        isValidUser(request.resource.data) &&
        isValidTime(request.resource.data.createdAt) &&
        request.resource.data.uid == userId &&
        (
          // Self-registration: enforce role 'citizen' and ownership
          (
            isOwner(userId) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == 'citizen' &&
            (!('panchayatId' in request.resource.data) || request.resource.data.panchayatId == null || request.resource.data.panchayatId == '')
          ) ||
          // Admin can provision any role
          isAdmin()
        );

      // User Profile & Preferences Update:
      // - Owners can update their own profile, language & UI preferences ('name', 'mobile',
      //   'panchayatName', 'preferredLang', 'uiPreferences', 'updatedAt', 'updatedBy') while
      //   'uid', 'createdAt', 'role', 'email', and 'panchayatId' remain strictly unchanged.
      // - Admins can update all user profiles and roles, but cannot tamper with uid or createdAt.
      allow update: if isAuthenticated() &&
        isValidUser(request.resource.data) &&
        areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
        (
          // Owner self-update: restricted to profile, language & UI preference fields
          (
            isOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'mobile', 'panchayatName', 'preferredLang', 'uiPreferences', 'updatedAt', 'updatedBy'
            ]) &&
            areImmutableFieldsUnchanged(['uid', 'createdAt', 'role', 'email', 'panchayatId']) &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.email == resource.data.email
          ) ||
          // Admin full profile & role management
          isAdmin()
        );

      // Only administrators can delete user accounts
      allow delete: if isAdmin();

      // -----------------------------------------------------------
      // 1b. Citizen AI Chat Sessions Subcollection (Strictly Owner-Only)
      // -----------------------------------------------------------
      match /chatSessions/{sessionId} {
        // Strictly owner-only: even admins and receivers must NOT read private citizen chat history.
        allow read: if isAuthenticated() && isOwner(userId);

        allow create: if isAuthenticated() &&
          isOwner(userId) &&
          isValidChatSession(request.resource.data) &&
          request.resource.data.sessionId == sessionId &&
          request.resource.data.userId == userId &&
          request.resource.data.userId == request.auth.uid;

        allow update: if isAuthenticated() &&
          isOwner(userId) &&
          isValidChatSession(request.resource.data) &&
          areImmutableFieldsUnchanged(['sessionId', 'userId', 'createdAt']) &&
          request.resource.data.sessionId == sessionId &&
          request.resource.data.userId == userId &&
          request.resource.data.userId == request.auth.uid;

        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // -------------------------------------------------------------
    // 2. Panchayats Collection
    // -------------------------------------------------------------
    match /panchayats/{panchayatId} {
      // Public directory read access so citizens can browse Panchayat directory
      // and select their Gram Panchayat in registration and complaint forms.
      allow read: if true;

      // Only administrators can create, update, or delete panchayats
      allow create: if isAdmin() &&
        isValidPanchayat(request.resource.data) &&
        request.resource.data.panchayatId == panchayatId;

      allow update: if isAdmin() &&
        isValidPanchayat(request.resource.data) &&
        areImmutableFieldsUnchanged(['panchayatId', 'createdAt']);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 3. Officers Collection (Gram Panchayat Officers Directory)
    // -------------------------------------------------------------
    match /officers/{officerId} {
      // Directory access to inspect official Gram Panchayat officers
      allow read: if true;

      // Only administrators can manage officers
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['name', 'designation', 'panchayatId']) &&
        (request.resource.data.name is string && request.resource.data.name.size() <= 100) &&
        (request.resource.data.designation is string && request.resource.data.designation.size() <= 100) &&
        (request.resource.data.panchayatId is string && request.resource.data.panchayatId.size() <= 50);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. Complaints Collection
    // -------------------------------------------------------------
    match /complaints/{complaintId} {
      // Document Read & Collection Queries / List: Authenticated and strictly scoped:
      // - Citizens can query their own complaints (userId == auth.uid)
      // - Panchayat receivers can query complaints assigned to their panchayat
      // - Admins can query all complaints
      allow get, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isReceiverForPanchayat(resource.data.panchayatId) ||
        isAdmin()
      );

      // Citizen Complaint Submission:
      // - Must be authenticated citizen
      // - userId must match creator's auth.uid
      // - Initial status must strictly start as 'Submitted' or 'SUBMITTED'
      // - Citizens cannot inject official responses, receiver assignment, or internal notes upon creation
      allow create: if isAuthenticated() &&
        isValidComplaint(request.resource.data) &&
        request.resource.data.complaintId == complaintId &&
        (
          (
            request.resource.data.userId == request.auth.uid &&
            (request.resource.data.status in ['Submitted', 'SUBMITTED']) &&
            (!('officialResponse' in request.resource.data) ||
             request.resource.data.officialResponse == null ||
             request.resource.data.officialResponse == '' ||
             request.resource.data.officialResponse == 'Your grievance has been successfully submitted and permanently recorded. It has been routed to the Gram Panchayat processing queue.') &&
            (!('internalNotes' in request.resource.data) ||
             request.resource.data.internalNotes == null ||
             request.resource.data.internalNotes == '') &&
            (!('assignedReceiverId' in request.resource.data) ||
             request.resource.data.assignedReceiverId == null ||
             request.resource.data.assignedReceiverId == '' ||
             request.resource.data.assignedReceiverId == ('rec-' + request.resource.data.panchayatId))
          ) ||
          isAdmin()
        );

      // Complaint Updates:
      // - Immutable core metadata: complaintId, userId, and createdAt cannot be altered under any circumstances.
      // - Receiver Assignment Validation: When an official updates assignedReceiverId, validate that it matches the complaint's actual Panchayat.
      // - Admins: Can update statuses, assign receivers, record rejection/reopen reasons, and add official responses/notes
      //   while preserving core immutable identifiers ['complaintId', 'userId', 'createdAt'].
      // - Panchayat Receivers: Can update permitted workflow keys (including workProgress) for complaints within their assigned Gram Panchayat.
      // - Citizens: Can submit feedback, reopen their own complaints with a valid reopenReason, or soft-delete their own grievance.
      allow update: if isAuthenticated() &&
        isValidComplaint(request.resource.data) &&
        areImmutableFieldsUnchanged(['complaintId', 'userId', 'createdAt']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedReceiverId']) ||
          request.resource.data.assignedReceiverId == ('rec-' + resource.data.panchayatId) ||
          isReceiverForPanchayat(resource.data.panchayatId) ||
          isAdmin()
        ) &&
        (
          // Admin superuser update
          isAdmin() ||
          // Panchayat Receiver official update
          (
            isReceiverForPanchayat(resource.data.panchayatId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'officialResponse',
              'assignedReceiverId', 'assignedReceiverEmail', 'assignedReceiverName',
              'latestResponse', 'latestResponseAt', 'latestResponseBy',
              'rejectionReason', 'reopenReason', 'expectedResolutionDate',
              'internalNotes', 'officialResponses', 'statusHistory',
              'resolutionDate', 'lastUpdatedDate', 'assignedDepartment', 'assignedReceiverUid',
              'aiPriority', 'documentAnalysis', 'workProgress'
            ]) &&
            areImmutableFieldsUnchanged(['citizenName', 'citizenEmail', 'panchayatId', 'category', 'description', 'photoURL'])
          ) ||
          // Citizen owner update: Citizen Feedback submission
          (
            isOwner(resource.data.userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['citizenFeedback'])
          ) ||
          // Citizen owner update: Request reopening
          (
            isOwner(resource.data.userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenReason', 'updatedAt']) &&
            request.resource.data.status in ['Reopened', 'REOPENED']
          ) ||
          // Citizen owner update: Soft-delete own complaint
          (
            isOwner(resource.data.userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedByCitizen', 'deletedAt', 'deletionReason', 'updatedAt'])
          )
        );

      // Only administrators can delete complaint records
      allow delete: if isAdmin();

      // Subcollection: Status History for this specific complaint
      match /statusHistory/{subHistoryId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          isComplaintOwnerExisting(complaintId) ||
          isComplaintReceiverExisting(complaintId)
        );

        allow create: if isAuthenticated() &&
          isValidStatusHistory(request.resource.data) &&
          request.resource.data.complaintId == complaintId &&
          (
            isAdmin() ||
            (
              request.resource.data.updatedBy == request.auth.uid &&
              (
                ((request.resource.data.newStatus in ['Submitted', 'SUBMITTED']) &&
                 (isComplaintOwnerExisting(complaintId) || isComplaintOwnerAfter(complaintId))) ||
                ((request.resource.data.newStatus in ['Reopened', 'REOPENED']) &&
                 isComplaintOwnerExisting(complaintId))
              )
            ) ||
            (isReceiver() && isComplaintReceiverExisting(complaintId))
          );

        allow update: if false;
        allow delete: if isAdmin();
      }

      // Subcollection: Messages & Official Responses for this specific complaint
      match /messages/{messageId} {
        // READ:
        // - Admins can read all messages
        // - Panchayat receivers can read messages for complaints in their panchayat
        // - Citizens can read messages for their own complaint ONLY IF visibility == 'public' (citizens cannot read internal notes)
        allow read: if isAuthenticated() && (
          isAdmin() ||
          isComplaintReceiverExisting(complaintId) ||
          (isComplaintOwnerExisting(complaintId) && (resource.data.visibility in ['public', 'PUBLIC']))
        );

        // CREATE:
        // - Admins can create official responses (public) and internal notes (internal)
        // - Panchayat receivers can create responses and notes for complaints in their panchayat
        // - Citizens can create citizen messages for their own complaint (senderRole == 'citizen', visibility == 'public')
        allow create: if isAuthenticated() &&
          isValidMessage(request.resource.data) &&
          request.resource.data.complaintId == complaintId &&
          request.resource.data.senderId == request.auth.uid &&
          (
            isAdmin() ||
            isComplaintReceiverExisting(complaintId) ||
            (
              (isComplaintOwnerExisting(complaintId) || isComplaintOwnerAfter(complaintId)) &&
              (request.resource.data.senderRole in ['citizen', 'CITIZEN']) &&
              (request.resource.data.visibility in ['public', 'PUBLIC'])
            )
          );

        // UPDATE: Admins can delete or archive/update if needed; citizens cannot alter or delete messages
        allow update: if isAdmin() &&
          isValidMessage(request.resource.data) &&
          areImmutableFieldsUnchanged(['complaintId', 'senderId', 'createdAt']);

        // DELETE: Only admins can delete/purge messages
        allow delete: if isAdmin();
      }

      // Subcollection: Dedicated Updates Folder for this specific complaint
      match /updates/{updateId} {
        // READ:
        // - Admin can read all updates
        // - Receiver can read updates for complaints in their panchayat
        // - Citizen can read updates for their own complaint
        allow read: if isAuthenticated() && (
          isAdmin() ||
          isComplaintReceiverExisting(complaintId) ||
          isComplaintOwnerExisting(complaintId) ||
          (resource.data.authorUid == request.auth.uid) ||
          (('citizenEmail' in resource.data) && ('email' in request.auth.token) && resource.data.citizenEmail == request.auth.token.email)
        );

        // CREATE:
        // - Admin can create updates
        // - Assigned Panchayat Receiver can create updates
        // - Complaint Owner (Citizen) can create updates (initial submission, withdrawal, or citizen remarks)
        allow create: if isAuthenticated() &&
          isValidComplaintUpdate(request.resource.data) &&
          request.resource.data.updateId == updateId &&
          request.resource.data.complaintId == complaintId &&
          (
            isAdmin() ||
            isComplaintReceiverExisting(complaintId) ||
            isComplaintReceiverAfter(complaintId) ||
            (
              (
                isComplaintOwnerExisting(complaintId) ||
                isComplaintOwnerAfter(complaintId) ||
                request.resource.data.authorUid == request.auth.uid
              ) &&
              (request.resource.data.authorRole in ['citizen', 'CITIZEN'])
            )
          );

        // UPDATE: Strictly restricted to Admin with immutable core identifiers
        allow update: if isAdmin() &&
          isValidComplaintUpdate(request.resource.data) &&
          areImmutableFieldsUnchanged(['updateId', 'complaintId', 'timestamp', 'authorUid']);

        // DELETE: Strictly restricted to Admin
        allow delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------
    // 5. Status History Collection (Root / Collection-Group)
    // -------------------------------------------------------------
    match /statusHistory/{historyId} {
      // Readable by the complaint's creator, assigned receiver, or admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isComplaintOwnerExisting(resource.data.complaintId) ||
        isComplaintReceiverExisting(resource.data.complaintId)
      );

      // Created when complaint status changes:
      // - Initial status record created by complaint submitter
      // - Status transition logged by authorized receiver or admin
      allow create: if isAuthenticated() &&
        isValidStatusHistory(request.resource.data) &&
        (
          isAdmin() ||
          (
            request.resource.data.updatedBy == request.auth.uid &&
            (
              ((request.resource.data.newStatus in ['Submitted', 'SUBMITTED']) &&
               (isComplaintOwnerExisting(request.resource.data.complaintId) ||
                isComplaintOwnerAfter(request.resource.data.complaintId))) ||
              ((request.resource.data.newStatus in ['Reopened', 'REOPENED']) &&
               isComplaintOwnerExisting(request.resource.data.complaintId))
            )
          ) ||
          (
            isReceiver() &&
            (isComplaintReceiverExisting(request.resource.data.complaintId) ||
             isComplaintReceiverAfter(request.resource.data.complaintId))
          )
        );

      // Status history entries are an append-only, immutable audit trail
      allow update: if false;

      // Only administrators can purge audit log records
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. Complaint Messages Root Collection / Collection-Group
    // -------------------------------------------------------------
    match /complaintMessages/{messageId} {
      // READ:
      // - Admins can read all messages
      // - Panchayat receivers can read messages for complaints in their panchayat
      // - Citizens can read messages for their own complaint ONLY IF visibility == 'public'
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isComplaintReceiverExisting(resource.data.complaintId) ||
        (isComplaintOwnerExisting(resource.data.complaintId) && (resource.data.visibility in ['public', 'PUBLIC']))
      );

      // CREATE:
      // - Admins can create responses (public) and internal notes (internal)
      // - Panchayat receivers can create responses for complaints in their panchayat
      // - Citizens can create citizen messages for their own complaint (senderRole == 'citizen', visibility == 'public')
      allow create: if isAuthenticated() &&
        isValidMessage(request.resource.data) &&
        request.resource.data.senderId == request.auth.uid &&
        (
          isAdmin() ||
          isComplaintReceiverExisting(request.resource.data.complaintId) ||
          (
            (isComplaintOwnerExisting(request.resource.data.complaintId) || isComplaintOwnerAfter(request.resource.data.complaintId)) &&
            (request.resource.data.senderRole in ['citizen', 'CITIZEN']) &&
            (request.resource.data.visibility in ['public', 'PUBLIC'])
          )
        );

      // UPDATE: Admins can delete or archive/update if needed; citizens cannot alter or delete messages
      allow update: if isAdmin() &&
        isValidMessage(request.resource.data) &&
        areImmutableFieldsUnchanged(['complaintId', 'senderId', 'createdAt']);

      // DELETE: Only admins can delete/purge messages
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. Email Logs Collection (Receiver Email Delivery Audit Records)
    // -------------------------------------------------------------
    match /emailLogs/{logId} {
      // READ: Strictly Receiver only. Admin and Citizen must NOT be permitted to read receiver email logs.
      allow read: if isReceiver();

      // CREATE: Receiver-only for browser-originated test/manual log entries.
      // Cloud Functions use the Admin SDK and bypass rules for trusted system logs.
      // This prevents citizens from forging delivery records or injecting misleading audit data.
      allow create: if isReceiver() &&
        isValidEmailLog(request.resource.data);

      // UPDATE: Strictly Receiver only with schema validation
      allow update: if isReceiver() &&
        isValidEmailLog(request.resource.data);

      // DELETE: Strictly authorized Receiver only, allowing the receiver to delete individual email delivery audit records or clear their history as required by the Receiver Settings module.
      allow delete: if isReceiver();
    }

    // -------------------------------------------------------------
    // 8. Administrative Audit Logs Collection
    // -------------------------------------------------------------
    match /adminAuditLogs/{logId} {
      // READ: Strictly Administrator only
      allow read: if isAdmin();

      // CREATE: Strictly Administrator only, requiring mandatory fields (action, adminId, timestamp)
      allow create: if isAdmin() &&
        isValidAdminAuditLog(request.resource.data);

      // UPDATE & DELETE: Strictly forbidden (Immutable audit trail)
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // 9. Notifications Collection
    // -------------------------------------------------------------
    match /notifications/{notifId} {
      // READ:
      // Authenticated recipient (userId matches auth.uid or email matches token email) or Admin
      allow read: if isAuthenticated() && (
        isNotificationRecipient() ||
        isAdmin()
      );

      // CREATE:
      // Administrators or Receivers dispatching notifications
      allow create: if (isAdmin() || isReceiver()) &&
        isValidNotification(request.resource.data);

      // UPDATE:
      // Recipient owner can mark read (only 'read' and 'readAt' can be updated)
      allow update: if isAuthenticated() &&
        isValidNotification(request.resource.data) &&
        areImmutableFieldsUnchanged(['createdAt', 'userId', 'email']) &&
        (
          (
            isNotificationRecipient() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          ) ||
          isAdmin()
        );

      // DELETE:
      // Recipient owner or administrator can delete
      allow delete: if isAuthenticated() && (
        isNotificationRecipient() ||
        isAdmin()
      );
    }

    // -------------------------------------------------------------
    // 10. Receiver Settings Collection (STRICTLY RECEIVER-ONLY)
    // -------------------------------------------------------------
    match /receiverSettings/{settingId} {
      // Access: STRICTLY RECEIVER-ONLY. Admin is EXPLICITLY FORBIDDEN from reading receiverSettings.
      allow read: if isReceiver();

      // Access: STRICTLY RECEIVER-ONLY. Admin is EXPLICITLY FORBIDDEN from creating or updating receiverSettings.
      allow create: if isReceiver() &&
        isValidReceiverSettings(request.resource.data);

      allow update: if isReceiver() &&
        isValidReceiverSettings(request.resource.data);

      // Deletion is strictly forbidden
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 11. Receiver Settings Audit Collection (STRICTLY RECEIVER-ONLY)
    // -------------------------------------------------------------
    match /receiverSettingsAudit/{auditId} {
      // READ: Strictly authorized Receiver only
      allow read: if isReceiver();

      // CREATE: Strictly authorized Receiver only, requiring mandatory audit fields and bounded payload sizes
      allow create: if isReceiver() &&
        request.resource.data.keys().hasAll(['changedBy', 'timestamp']) &&
        request.resource.data.keys().size() <= 20 &&
        (request.resource.data.changedBy is string && request.resource.data.changedBy.size() >= 1 && request.resource.data.changedBy.size() <= 100) &&
        isValidOptionalString(request.resource.data, 'auditId', 0, 100) &&
        isValidOptionalString(request.resource.data, 'previousEmail', 0, 100) &&
        isValidOptionalString(request.resource.data, 'newEmail', 0, 100) &&
        isValidOptionalString(request.resource.data, 'section', 0, 60) &&
        isValidOptionalString(request.resource.data, 'action', 0, 100) &&
        isValidOptionalString(request.resource.data, 'userAgent', 0, 1000) &&
        isValidOptionalString(request.resource.data, 'status', 0, 50) &&
        isValidTime(request.resource.data.timestamp);

      // UPDATE & DELETE: Strictly forbidden (Immutable audit trail)
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // 12. Backups Collection (System Database Snapshots)
    // -------------------------------------------------------------
    match /backups/{backupId} {
      // READ, CREATE, UPDATE, DELETE: strictly isAdmin()
      allow read, create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 13. Offline Sync Records Collection (Offline Synchronization)
    // -------------------------------------------------------------
    match /offlineSyncRecords/{recordId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId || isAdmin());
    }

    // -------------------------------------------------------------
    // 14. Panchayat Analytics Collection (Intelligence & Hotspots)
    // -------------------------------------------------------------
    match /panchayatAnalytics/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 15. Dynamic Complaint Status Configuration Collection
    // -------------------------------------------------------------
    match /complaintStatusConfig/{configId} {
      // READ: Any authenticated user (Citizens, Receivers, Admins) has access to active status configuration
      allow read: if isAuthenticated();

      // CREATE, UPDATE: STRICTLY Administrator only
      allow create: if isAdmin() &&
        isValidComplaintStatusConfig(request.resource.data);

      allow update: if isAdmin() &&
        isValidComplaintStatusConfig(request.resource.data);

      // DELETE: Strictly forbidden to preserve historical stability
      allow delete: if false;

      // Subcollections: Complaint Transition Rules attached to specific configuration
      match /complaintTransitionRules/{ruleId} {
        allow read: if isAuthenticated();
        allow create: if isAdmin() && isValidComplaintTransitionRule(request.resource.data);
        allow update: if isAdmin() && isValidComplaintTransitionRule(request.resource.data);
        allow delete: if false;
      }

      match /transitionRules/{ruleId} {
        allow read: if isAuthenticated();
        allow create: if isAdmin() && isValidComplaintTransitionRule(request.resource.data);
        allow update: if isAdmin() && isValidComplaintTransitionRule(request.resource.data);
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------
    // 16. Complaint Transition Rules Collection (Root Level)
    // -------------------------------------------------------------
    match /complaintTransitionRules/{ruleId} {
      // READ: Any authenticated user can read workflow transition rules
      allow read: if isAuthenticated();

      // CREATE, UPDATE: STRICTLY Administrator only
      allow create: if isAdmin() &&
        isValidComplaintTransitionRule(request.resource.data);

      allow update: if isAdmin() &&
        isValidComplaintTransitionRule(request.resource.data);

      // DELETE: Strictly forbidden
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 17. Citizens Collection (Dedicated alias/collection for citizen records)
    // -------------------------------------------------------------
    match /citizens/{citizenId} {
      allow read: if isAuthenticated() && (isOwner(citizenId) || isAdmin() || isReceiver());
      allow create, update: if isAuthenticated() && (isOwner(citizenId) || isAdmin());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 18. Emergency Reset Audit Logs Collection (Immutable Audit Trail)
    // -------------------------------------------------------------
    match /emergencyResetAuditLogs/{logId} {
      // READ: strictly isAdmin() only
      allow read: if isAdmin();

      // CREATE: strictly isAdmin() only, validating schema, adminId matching uid, and email matching token
      allow create: if isAdmin() &&
        isValidEmergencyResetAuditLog(request.resource.data) &&
        request.resource.data.adminId == request.auth.uid &&
        (('email' in request.auth.token) && request.resource.data.adminEmail == request.auth.token.email);

      // UPDATE: strictly forbidden
      allow update: if false;

      // DELETE: strictly isAdmin() only
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 19. Emergency Reset Backups Collection (Disaster Recovery Snapshots)
    // -------------------------------------------------------------
    match /emergencyResetBackups/{backupId} {
      // READ: strictly isAdmin() only
      allow read: if isAdmin();

      // CREATE: strictly isAdmin() only, validating schema and admin ownership
      allow create: if isAdmin() &&
        isValidEmergencyResetBackup(request.resource.data) &&
        request.resource.data.adminId == request.auth.uid;

      // UPDATE: strictly isAdmin() only, validating schema and preserving immutable fields
      allow update: if isAdmin() &&
        isValidEmergencyResetBackup(request.resource.data) &&
        areImmutableFieldsUnchanged(['backupId', 'createdAt']);

      // DELETE: strictly isAdmin() only, allowing administrators to remove old emergency backup snapshots
      allow delete: if isAdmin();

      match /{allChildren=**} {
        allow read, write: if isAdmin();
      }
    }

    // -------------------------------------------------------------
    // 20. System Settings Collection (Maintenance Mode, Emergency Locks, Admin Banner & Assistant Config)
    // -------------------------------------------------------------
    match /systemSettings/{settingId} {
      // READ:
      // - Public single-doc GET allowed for 'adminBanner', 'banner', and 'maintenance' so visitors and citizens
      //   can see the active portal banner and maintenance mode status.
      // - Authenticated read/list (including isAdmin()) allowed for all systemSettings docs (no secrets stored).
      allow get: if (settingId in ['adminBanner', 'banner', 'maintenance']) || isAuthenticated();
      allow list: if isAuthenticated();

      // CREATE, UPDATE: strictly authenticated Administrators (isAdmin()) only.
      // - 'maintenance': validated with isValidMaintenanceSettings (bool active, bounded message/reason <= 500, timestamps).
      // - 'assistantConfig': validated with isValidAssistantConfig (strictly forbids secret credential keys).
      // - 'adminBanner': validated with isValidAdminBanner.
      // - Other system settings (e.g. 'resetLock', 'banner'): strictly forbid secret credential keys & bound key count.
      allow create, update: if isAdmin() && (
        (settingId == 'maintenance' && isValidMaintenanceSettings(request.resource.data)) ||
        (settingId == 'assistantConfig' && isValidAssistantConfig(request.resource.data)) ||
        (settingId == 'adminBanner' && isValidAdminBanner(request.resource.data)) ||
        (!(settingId in ['maintenance', 'assistantConfig', 'adminBanner']) &&
          !request.resource.data.keys().hasAny([
            'apiKey', 'geminiKey', 'openaiKey', 'secret', 'apiSecret', 'token',
            'password', 'privateKey', 'clientSecret', 'secretKey', 'accessToken',
            'refreshToken', 'authToken', 'bearerToken', 'api_key', 'gemini_key',
            'openai_key', 'api_secret', 'geminiApiKey', 'openaiApiKey',
            'GEMINI_API_KEY', 'OPENAI_API_KEY', 'AI_API_KEY'
          ]) &&
          request.resource.data.keys().size() <= 30
        )
      );

      // DELETE:
      // - Non-essential portal state/banner documents ('adminBanner', 'banner', 'maintenance'):
      //   can be deleted/reset by authenticated Administrators (isAdmin()).
      // - Critical lock/config settings ('resetLock', 'assistantConfig'): strictly forbidden to prevent lockout.
      allow delete: if (settingId in ['adminBanner', 'banner', 'maintenance']) && isAdmin();
    }

    // -------------------------------------------------------------
    // 21. Admin Banners Collection (Hero Banner Image Management)
    // -------------------------------------------------------------
    match /adminBanners/{bannerId} {
      // READ:
      // - Single document get is public (allow get: if true;) so visitors can view the portal banner.
      // - Collection queries (list) allowed for all authenticated users.
      allow get: if true;
      allow list: if isAuthenticated();

      // CREATE: Strictly restricted to authenticated Administrators (isAdmin()) with schema validation and matching bannerId
      allow create: if isAdmin() &&
        isValidAdminBanner(request.resource.data) &&
        request.resource.data.bannerId == bannerId;

      // UPDATE: Strictly restricted to authenticated Administrators (isAdmin()) with schema validation and immutable field checks
      allow update: if isAdmin() &&
        isValidAdminBanner(request.resource.data) &&
        areImmutableFieldsUnchanged(['bannerId', 'uploadedAt']);

      // DELETE: Strictly restricted to authenticated Administrators (isAdmin())
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 22. Complaint Updates Collection (Dedicated Complaint Updates Folder)
    // -------------------------------------------------------------
    match /complaint_updates/{updateId} {
      // READ:
      // - Admin can read all updates.
      // - Receivers can read updates for grievances in their assigned Panchayat or assigned to them.
      // - Citizens can read updates corresponding to their own complaints (matching citizenEmail or authorUid or complaint owner).
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isReceiver() && (
          resource.data.panchayatId == getReceiverPanchayatId() ||
          isReceiverForPanchayat(resource.data.panchayatId) ||
          isComplaintReceiverExisting(resource.data.complaintId)
        )) ||
        (resource.data.authorUid == request.auth.uid) ||
        (('citizenEmail' in resource.data) && ('email' in request.auth.token) && resource.data.citizenEmail == request.auth.token.email) ||
        isComplaintOwnerExisting(resource.data.complaintId)
      );

      // CREATE:
      // - Admin and authenticated Receivers can write updates.
      // - Citizens can record initial submission updates or withdrawal/reopen requests.
      allow create: if isAuthenticated() &&
        isValidComplaintUpdate(request.resource.data) &&
        request.resource.data.updateId == updateId &&
        (
          isAdmin() ||
          (
            isReceiver() &&
            (
              isReceiverForPanchayat(request.resource.data.panchayatId) ||
              isComplaintReceiverExisting(request.resource.data.complaintId) ||
              isComplaintReceiverAfter(request.resource.data.complaintId)
            )
          ) ||
          (
            (
              isComplaintOwnerExisting(request.resource.data.complaintId) ||
              isComplaintOwnerAfter(request.resource.data.complaintId) ||
              request.resource.data.authorUid == request.auth.uid
            ) &&
            (request.resource.data.authorRole in ['citizen', 'CITIZEN'])
          )
        );

      // UPDATE: Restricted to Admin with immutable core checks
      allow update: if isAdmin() &&
        isValidComplaintUpdate(request.resource.data) &&
        areImmutableFieldsUnchanged(['updateId', 'complaintId', 'timestamp', 'authorUid']);

      // DELETE: Restricted to Admin
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 23. Recycle Bin Collection (Quarantined Soft-Deleted Complaints)
    // -------------------------------------------------------------
    match /recycle_bin/{recycleId} {
      // READ: Strictly Administrator only (isAdmin()). Citizens and Receivers have NO read access.
      allow read: if isAdmin();

      // CREATE: Strictly Administrator only (moving complaint to quarantine).
      allow create: if isAdmin() &&
        isValidRecycleBinItem(request.resource.data) &&
        request.resource.data.recycleId == recycleId;

      // UPDATE: Strictly Administrator only (updating restore status/notes).
      allow update: if isAdmin() &&
        isValidRecycleBinItem(request.resource.data) &&
        areImmutableFieldsUnchanged(['recycleId', 'complaintId', 'deletedAt']);

      // DELETE: Strictly Administrator only (permanent eradication / purge).
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 24. Activity Logs Collection (Administrative & Operational Audit Logs)
    // -------------------------------------------------------------
    match /activity_logs/{logId} {
      // READ: Strictly Administrator only (isAdmin())
      allow read: if isAdmin();

      // CREATE: Authenticated users (admin or receiver) logging authorized operations
      allow create: if isAuthenticated() &&
        (isAdmin() || isReceiver()) &&
        isValidActivityLog(request.resource.data) &&
        request.resource.data.logId == logId;

      // UPDATE: Strictly forbidden (immutable audit records)
      allow update: if false;

      // DELETE: Strictly Administrator only (emergency reset / pruning)
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 25. Complaint Attachments Collection (Evidence & Document Metadata)
    // -------------------------------------------------------------
    match /complaint_attachments/{attachmentId} {
      // READ: Admin, assigned Panchayat Receiver, or the Citizen owner
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isComplaintOwnerExisting(resource.data.complaintId) ||
        isComplaintReceiverExisting(resource.data.complaintId) ||
        (resource.data.uploaderUid == request.auth.uid) ||
        (('uploaderEmail' in resource.data) && ('email' in request.auth.token) && resource.data.uploaderEmail == request.auth.token.email)
      );

      // CREATE: Authenticated Citizen or Official attaching evidence
      allow create: if isAuthenticated() &&
        isValidComplaintAttachment(request.resource.data) &&
        request.resource.data.attachmentId == attachmentId &&
        (
          isAdmin() ||
          isComplaintReceiverExisting(request.resource.data.complaintId) ||
          isComplaintReceiverAfter(request.resource.data.complaintId) ||
          isComplaintOwnerExisting(request.resource.data.complaintId) ||
          isComplaintOwnerAfter(request.resource.data.complaintId) ||
          (request.resource.data.uploaderUid == request.auth.uid)
        );

      // UPDATE: Admin only
      allow update: if isAdmin() &&
        isValidComplaintAttachment(request.resource.data) &&
        areImmutableFieldsUnchanged(['attachmentId', 'complaintId', 'createdAt']);

      // DELETE: Admin only
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 26. Complaint Assignments Collection (Receiver Allocation Register)
    // -------------------------------------------------------------
    match /complaint_assignments/{assignmentId} {
      // READ: Admin and designated Receiver
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isReceiver() && (
          resource.data.panchayatId == getReceiverPanchayatId() ||
          resource.data.receiverId == request.auth.uid ||
          (('receiverEmail' in resource.data) && ('email' in request.auth.token) && resource.data.receiverEmail == request.auth.token.email)
        ))
      );

      // WRITE (CREATE, UPDATE, DELETE): Strictly Administrator only
      allow create: if isAdmin() &&
        isValidComplaintAssignment(request.resource.data) &&
        request.resource.data.assignmentId == assignmentId;

      allow update: if isAdmin() &&
        isValidComplaintAssignment(request.resource.data) &&
        areImmutableFieldsUnchanged(['assignmentId', 'complaintId', 'assignedAt']);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 27. AI Assistant Citizen Feedback Collection
    // -------------------------------------------------------------
    match /assistantFeedback/{feedbackId} {
      // READ: Creator citizen can read their own feedback; Admins can read all feedback reports
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // CREATE: Authenticated users can submit feedback under their own UID with initial status 'open'
      allow create: if isAuthenticated() &&
        isValidAssistantFeedback(request.resource.data) &&
        request.resource.data.feedbackId == feedbackId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        (!('adminNote' in request.resource.data) || request.resource.data.adminNote == null || request.resource.data.adminNote == '') &&
        (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == null || request.resource.data.reviewedBy == '') &&
        (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null || request.resource.data.reviewedAt == '');

      // UPDATE: Strictly Administrator only (review workflow), preserving immutable submission fields
      allow update: if isAdmin() &&
        isValidAssistantFeedback(request.resource.data) &&
        areImmutableFieldsUnchanged(['feedbackId', 'userId', 'rating', 'createdAt']);

      // DELETE: Strictly Administrator only
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 28. AI Assistant Analytics Collection (Server-Aggregated Metrics)
    // -------------------------------------------------------------
    match /assistantAnalytics/{docId} {
      // READ: Strictly Administrator only
      allow read: if isAdmin();

      // WRITE: Strictly forbidden from clients (written exclusively via Cloud Functions Admin SDK)
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 29. AI Assistant Rate Limits Collection (Server-Only Quota State)
    // -------------------------------------------------------------
    match /assistantRateLimits/{limitId} {
      // Strictly server-only Admin SDK access
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 30. Complaint Submission Idempotency Nonces (Server-Only Replay Guard)
    // -------------------------------------------------------------
    match /submissionNonces/{nonceId} {
      // Strictly server-only Admin SDK access
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 31. AI Knowledge Centre Documents (Server-Managed RAG Corpus)
    // -------------------------------------------------------------
    match /knowledge_documents/{docId} {
      // READ: Any user (public or signed in) can read ONLY active, indexed, non-quarantined, non-deleted documents;
      // Administrators (isAdmin()) can read all documents (including disabled, failed, quarantined, superseded, deleted).
      allow read: if isAdmin() || (
        resource.data.status == 'INDEXED' &&
        resource.data.enabled == true &&
        resource.data.quarantined == false &&
        resource.data.deleted == false
      );

      // WRITE: Strictly server-only Cloud Functions via Admin SDK (prevents client forgery of sourceReliability, status, enabled, or quarantined)
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // 32. AI Knowledge Centre Document Chunks
    // -------------------------------------------------------------
    match /knowledge_chunks/{chunkId} {
      // READ: Active chunks readable publicly for retrieval; Admins can inspect all chunks
      allow read: if isAdmin() || resource.data.active == true;

      // WRITE: Strictly server-only via Admin SDK
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // 33. AI Knowledge Centre Vector Embeddings
    // -------------------------------------------------------------
    match /knowledge_embeddings/{embeddingId} {
      // READ: Active embeddings readable publicly for retrieval; Admins can inspect all embeddings
      allow read: if isAdmin() || resource.data.active == true;

      // WRITE: Strictly server-only via Admin SDK
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // 34. AI Knowledge Centre Uploaders (Contributor PII & Quota Metadata)
    // -------------------------------------------------------------
    match /knowledge_uploaders/{uploaderId} {
      // READ: Strictly Administrator-only (protects contributor emails and private metadata from public scraping)
      allow read: if isAdmin();

      // WRITE: Strictly server-only via Admin SDK
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 35. AI Knowledge Centre Async Processing Jobs
    // -------------------------------------------------------------
    match /knowledge_processing_jobs/{jobId} {
      // READ: Strictly Administrator-only
      allow read: if isAdmin();

      // CREATE: Allow queued async staging ONLY with strict schema validation, QUEUED status,
      // community reliability (clients cannot force 'official'), and scoped temporary_uploads storage path.
      allow create: if isValidKnowledgeProcessingJob(request.resource.data) &&
        request.resource.data.jobId == jobId &&
        request.resource.data.status == 'QUEUED' &&
        request.resource.data.sourceReliability == 'community' &&
        (!('replaceDocId' in request.resource.data) || request.resource.data.replaceDocId == null || request.resource.data.replaceDocId == '' || isAdmin()) &&
        (
          isAdmin() ||
          (
            (!('contributorRole' in request.resource.data) || request.resource.data.contributorRole == null || request.resource.data.contributorRole == '' || request.resource.data.contributorRole == 'public' || (isAuthenticated() && request.resource.data.contributorRole == 'citizen')) &&
            (!('contributorId' in request.resource.data) || request.resource.data.contributorId == null || request.resource.data.contributorId == '' || request.resource.data.contributorId == 'public' || request.resource.data.contributorId == 'public-contributor' || request.resource.data.contributorId.matches("^pub-[a-zA-Z0-9_-]{1,32}$") || (isAuthenticated() && request.resource.data.contributorId == request.auth.uid))
          )
        );

      // UPDATE, DELETE: Strictly forbidden from clients (server Cloud Functions manage job lifecycle)
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // 36. AI Knowledge Centre Receiver API Configuration
    // -------------------------------------------------------------
    match /knowledge_api_receivers/{receiverId} {
      // READ: Strictly Administrator-only (NEVER readable by public users, citizens, or grievance receivers)
      allow read: if isAdmin();

      // WRITE: Strictly forbidden from clients (managed via updateKnowledgeApiSettings callable)
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 37. AI Knowledge Centre Receiver API Secrets (Hashes & HMAC Keys)
    // -------------------------------------------------------------
    match /knowledge_api_secrets/{secretId} {
      // Strictly server-only Admin SDK access (NEVER client readable or writable)
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 38. AI Knowledge Centre Receiver API Request Logs
    // -------------------------------------------------------------
    match /knowledge_api_logs/{logId} {
      // READ: Strictly Administrator-only
      allow read: if isAdmin();

      // WRITE: Strictly server-only via Admin SDK
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 39. AI Knowledge Centre Audit Logs (Immutable Append-Only Ledger)
    // -------------------------------------------------------------
    match /knowledge_audit_logs/{auditId} {
      // READ: Strictly Administrator-only
      allow read: if isAdmin();

      // WRITE: Strictly server-only via Admin SDK
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 40. AI Knowledge Centre Storage Usage Metrics
    // -------------------------------------------------------------
    match /knowledge_storage_usage/{docId} {
      // READ: Strictly Administrator-only
      allow read: if isAdmin();

      // WRITE: Strictly server-only via Admin SDK
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 41. AI Knowledge Centre Disaster Recovery Backups
    // -------------------------------------------------------------
    match /knowledge_backups/{backupId} {
      // READ: Strictly Administrator-only
      allow read: if isAdmin();

      // WRITE: Strictly server-only via Admin SDK
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 42. AI Knowledge Centre Receiver API Idempotency Keys
    // -------------------------------------------------------------
    match /knowledge_idempotency/{key} {
      // Strictly server-only Admin SDK access
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 43. AI Knowledge Centre Rate Limit Buckets
    // -------------------------------------------------------------
    match /knowledge_rate_limits/{bucketId} {
      // Strictly server-only Admin SDK access
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Default Deny Rule for All Other Collections
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
