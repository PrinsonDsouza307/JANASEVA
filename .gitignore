# Dependencies
node_modules/
functions/node_modules/

# Logs & Debugging
*.log
firebase-debug.log
firebase-debug.*.log
.firebase/
.netlify/

# OS Cache
.DS_Store
Thumbs.db

Android/source/.gradle/
Android/source/**/build/
Android/source/local.properties
*.jks
*.keystore
public/

# Working copies and platform build output
website/public/
backend/firebase/functions/node_modules/
android/source/.gradle/
android/source/app/build/
**/.env
**/.env.local
.ua/
.agents/
